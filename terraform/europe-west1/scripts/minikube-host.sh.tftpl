#!/bin/bash
# Tooling bootstrap for minikube-vm. Runs on every boot; each tool is only (re)installed when its pinned version is missing.
# Rendered by Terraform templatefile(): shell variables avoid braces, or escape them as $${VAR}.
set -euo pipefail

MINIKUBE_VERSION="${minikube_version}"
KUBECTL_VERSION="${kubectl_version}"
HELM_VERSION="${helm_version}"
FLEETCTL_VERSION="${fleetctl_version}"

BIN=/usr/local/bin
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

export DEBIAN_FRONTEND=noninteractive
if ! command -v docker >/dev/null || ! command -v make >/dev/null || ! command -v jq >/dev/null || ! command -v socat >/dev/null; then
  apt-get update
  apt-get install -y --no-install-recommends docker.io make git curl jq socat ca-certificates
fi
systemctl enable --now docker

# Fetch $1 to $2 and verify it against the bare sha256 published at $3.
fetch_verified() {
  curl -fsSL -o "$2" "$1"
  echo "$(curl -fsSL "$3" | awk '{print $1}')  $2" | sha256sum -c -
}

if [ "$($BIN/minikube version --short 2>/dev/null || true)" != "$MINIKUBE_VERSION" ]; then
  fetch_verified "https://storage.googleapis.com/minikube/releases/$MINIKUBE_VERSION/minikube-linux-amd64" \
    "$TMP/minikube" "https://storage.googleapis.com/minikube/releases/$MINIKUBE_VERSION/minikube-linux-amd64.sha256"
  install -m 0755 "$TMP/minikube" "$BIN/minikube"
fi

if ! $BIN/kubectl version --client 2>/dev/null | grep -q "Client Version: $KUBECTL_VERSION\$"; then
  fetch_verified "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl" \
    "$TMP/kubectl" "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl.sha256"
  install -m 0755 "$TMP/kubectl" "$BIN/kubectl"
fi

if ! $BIN/helm version --template '{{.Version}}' 2>/dev/null | grep -qx "$HELM_VERSION"; then
  fetch_verified "https://get.helm.sh/helm-$HELM_VERSION-linux-amd64.tar.gz" \
    "$TMP/helm.tgz" "https://get.helm.sh/helm-$HELM_VERSION-linux-amd64.tar.gz.sha256sum"
  tar -xzf "$TMP/helm.tgz" -C "$TMP"
  install -m 0755 "$TMP/linux-amd64/helm" "$BIN/helm"
fi

if ! $BIN/fleetctl --version 2>/dev/null | grep -q "fleetctl - version $FLEETCTL_VERSION\b"; then
  FLEET_TAG="fleet-v$FLEETCTL_VERSION"
  ASSET="fleetctl_v$${FLEETCTL_VERSION}_linux_amd64.tar.gz"
  curl -fsSL -o "$TMP/$ASSET" "https://github.com/fleetdm/fleet/releases/download/$FLEET_TAG/$ASSET"
  curl -fsSL -o "$TMP/checksums.txt" "https://github.com/fleetdm/fleet/releases/download/$FLEET_TAG/checksums.txt"
  (cd "$TMP" && grep " $ASSET\$" checksums.txt | sha256sum -c -)
  tar -xzf "$TMP/$ASSET" -C "$TMP"
  install -m 0755 "$(find "$TMP" -type f -name fleetctl | head -n1)" "$BIN/fleetctl"
fi

echo "minikube-vm ready: minikube $MINIKUBE_VERSION, kubectl $KUBECTL_VERSION, helm $HELM_VERSION, fleetctl $FLEETCTL_VERSION"
