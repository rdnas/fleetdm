#!/bin/bash
# OpenVPN server bootstrap for vpn-vm. Runs on every boot; safe to re-run.
# Rendered by Terraform templatefile(): shell variables avoid braces, or escape them as $${VAR}.
set -euo pipefail

VPN_PORT="${vpn_port}"
VPN_NETWORK="${vpn_client_network}"
VPN_NETMASK="${vpn_client_netmask}"
VPN_CIDR="${vpn_client_cidr}"
SUBNET_NETWORK="${subnet_network}"
SUBNET_NETMASK="${subnet_netmask}"
DNS_DOMAIN="${dns_domain}"
CLIENT_NAME="${client_name}"

MD="http://metadata.google.internal/computeMetadata/v1"
EASYRSA_DIR=/etc/openvpn/easy-rsa
SERVER_DIR=/etc/openvpn/server
CLIENT_DIR=/etc/openvpn/client-configs

export DEBIAN_FRONTEND=noninteractive
if ! command -v openvpn >/dev/null || ! command -v nft >/dev/null || [ ! -d /usr/share/easy-rsa ]; then
  apt-get update
  apt-get install -y --no-install-recommends openvpn easy-rsa nftables curl ca-certificates
fi

# --- PKI (EC keys keep the inline client profile small enough for a guest attribute) ---
if [ ! -f "$EASYRSA_DIR/pki/ca.crt" ]; then
  rm -rf "$EASYRSA_DIR"
  mkdir -p "$EASYRSA_DIR"
  cp -a /usr/share/easy-rsa/. "$EASYRSA_DIR/"
  cd "$EASYRSA_DIR"
  export EASYRSA_BATCH=1 EASYRSA_ALGO=ec EASYRSA_CURVE=prime256v1 EASYRSA_CA_EXPIRE=3650 EASYRSA_CERT_EXPIRE=825
  ./easyrsa init-pki
  EASYRSA_REQ_CN="fleetdm-vpn-ca" ./easyrsa build-ca nopass
  ./easyrsa build-server-full server nopass
  ./easyrsa build-client-full "$CLIENT_NAME" nopass
fi

mkdir -p "$SERVER_DIR" "$CLIENT_DIR" /var/log/openvpn
install -m 0644 "$EASYRSA_DIR/pki/ca.crt" "$SERVER_DIR/ca.crt"
install -m 0644 "$EASYRSA_DIR/pki/issued/server.crt" "$SERVER_DIR/server.crt"
install -m 0600 "$EASYRSA_DIR/pki/private/server.key" "$SERVER_DIR/server.key"
[ -f "$SERVER_DIR/tc.key" ] || openvpn --genkey secret "$SERVER_DIR/tc.key"
chmod 0600 "$SERVER_DIR/tc.key"

# --- Server config ---
cat > "$SERVER_DIR/server.conf" <<EOF
port $VPN_PORT
proto udp
dev tun
topology subnet
server $VPN_NETWORK $VPN_NETMASK
ca $SERVER_DIR/ca.crt
cert $SERVER_DIR/server.crt
key $SERVER_DIR/server.key
dh none
tls-crypt $SERVER_DIR/tc.key
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
push "route $SUBNET_NETWORK $SUBNET_NETMASK"
push "route 169.254.169.254 255.255.255.255"
push "dhcp-option DNS 169.254.169.254"
push "dhcp-option DOMAIN $DNS_DOMAIN"
keepalive 10 120
user nobody
group nogroup
persist-key
persist-tun
status /var/log/openvpn/status.log
verb 3
explicit-exit-notify 1
EOF

# --- Forwarding + NAT: VPN clients appear as this VM inside the VPC (including to the metadata DNS resolver) ---
cat > /etc/sysctl.d/99-openvpn-forward.conf <<EOF
net.ipv4.ip_forward = 1
EOF
sysctl -q -p /etc/sysctl.d/99-openvpn-forward.conf

EGRESS_IF="$(ip -4 route show default | awk '{print $5; exit}')"
EGRESS_IF="$${EGRESS_IF:-ens4}"
cat > /etc/nftables.conf <<EOF
#!/usr/sbin/nft -f
flush ruleset

table ip openvpn_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr $VPN_CIDR oifname "$EGRESS_IF" masquerade
  }
}
EOF
systemctl enable nftables
systemctl restart nftables

systemctl enable openvpn-server@server
systemctl restart openvpn-server@server

# --- Client profile, published as guest attribute openvpn/client ---
EXTERNAL_IP="$(curl -fsS -H 'Metadata-Flavor: Google' "$MD/instance/network-interfaces/0/access-configs/0/external-ip")"
PROFILE="$CLIENT_DIR/$CLIENT_NAME.ovpn"
{
  cat <<EOF
client
dev tun
proto udp
remote $EXTERNAL_IP $VPN_PORT
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
verb 3
# Linux clients with systemd-resolved: install openvpn-systemd-resolved and uncomment
# script-security 2
# up /etc/openvpn/update-systemd-resolved
# down /etc/openvpn/update-systemd-resolved
# down-pre
EOF
  echo "<ca>";        cat "$SERVER_DIR/ca.crt";                                             echo "</ca>"
  echo "<cert>";      openssl x509 -in "$EASYRSA_DIR/pki/issued/$CLIENT_NAME.crt";        echo "</cert>"
  echo "<key>";       cat "$EASYRSA_DIR/pki/private/$CLIENT_NAME.key";                     echo "</key>"
  echo "<tls-crypt>"; cat "$SERVER_DIR/tc.key";                                             echo "</tls-crypt>"
} > "$PROFILE"
chmod 0600 "$PROFILE"

curl -fsS -X PUT --data-binary "@$PROFILE" -H 'Metadata-Flavor: Google' \
  "$MD/instance/guest-attributes/openvpn/client"

echo "OpenVPN ready on $EXTERNAL_IP:$VPN_PORT/udp; client profile published to guest attribute openvpn/client"
